# Default mode automatically starts temporary local MongoDB, no Atlas URL needed.
DB_MODE=memory
# Set DB_MODE=file to use persistent local JSON storage (not MongoDB) if the MongoDB binary cannot download.
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# Optional only if DB_MODE=atlas:
# MONGODB_URI=mongodb+srv://youruser:yourpassword@yourcluster.mongodb.net/taskmate
